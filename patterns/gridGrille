const gridGrille = (canvas) => {
  const ctx = canvas.getContext('2d')
  ctx.fillStyle = `rgba(0, 0, 0, 0.25)`

  // Horizontal lines
  for (let y = Math.round(canvas.height / 64); y < canvas.height; y += Math.round(canvas.height / 16)) {
    ctx.fillRect(0, y, canvas.width, Math.round(canvas.height / 32))
  }

  // Vertical lines
  for (let x = Math.round(canvas.width / 64); x < canvas.width; x += Math.round(canvas.width / 16)) {
    ctx.fillRect(x, 0, Math.round(canvas.width / 32), canvas.height)
  }
    }

export default gridGrille
